{
  "description": "Capture user prompts and final assistant responses for the 8x assignment.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/capture_turn.py prompt",
            "commandWindows": "chcp 65001 >nul & python -X utf8 \".codex\\capture_turn.py\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/capture_turn.py response",
            "commandWindows": "chcp 65001 >nul & python -X utf8 \".codex\\capture_turn.py\" response",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
